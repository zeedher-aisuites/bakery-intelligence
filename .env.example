# Bakery Intelligence local environment (never commit values).
# Copy to .env and fill in. Process-exported variables win over
# this file; META_API_KEY wins over MODEL_API_KEY.

# Meta Model API key (billable frame/global/audio inference).
META_API_KEY=
# Fallback Meta key name (used only when META_API_KEY is unset).
MODEL_API_KEY=

# Baseten inference key (segments, fusion, recipe revision).
BASETEN_API_KEY=
# Baseten deployment override (default shown).
# BAKERY_BASETEN_MODEL=meta-models/muse-spark-open-1026

# Worker engine fallback when the grant names none:
# single_frame | contextual_batch | focused_batch | parallel_scale.
# FIRSTPASS_ENGINE=single_frame

# Size gates in bytes (defaults shown).
# BAKERY_MAX_VIDEO_UPLOAD_BYTES=2147483648
# BAKERY_PIPELINE_MAX_VIDEO_BYTES=16777216
