{
  "$defs": {
    "ReviewDecisionValue": {
      "description": "Human review decision (plan.md \u00a74.2, \u00a78).",
      "enum": [
        "approved",
        "rejected",
        "needs_revision"
      ],
      "title": "ReviewDecisionValue",
      "type": "string"
    }
  },
  "$id": "https://bakery-intelligence.local/schemas/1.0.0/review_decision.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An explicit, version-pinned human decision on one draft version.\n\nApproving version N never approves version N+1 (plan.md \u00a78.1). No\nautomatic processing path may create an ``approved`` decision\n(Constitution V).",
  "properties": {
    "corrections_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corrections Ref"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ReviewDecisionValue"
    },
    "decision_id": {
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "draft_id": {
      "minLength": 1,
      "title": "Draft Id",
      "type": "string"
    },
    "draft_version": {
      "minimum": 1,
      "title": "Draft Version",
      "type": "integer"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "reviewer_id": {
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^1\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "draft_id",
    "draft_version",
    "reviewer_id",
    "decision",
    "decided_at"
  ],
  "title": "ReviewDecision",
  "type": "object"
}
